# Example .env file - DO NOT COMMIT SECRETS
# Copy this to .env and fill values locally.

# Flask
FLASK_SECRET_KEY=

# Logging centralizado
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FILE_LEVEL=ERROR
LOG_FILE_PATH=./logs/server.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_DB_ENABLED=false
LOG_DB_LEVEL=ERROR
LOG_DB_QUEUE_SIZE=1000
LOG_DB_RETENTION_DAYS=30
LOG_DB_MAX_ROWS=50000
LOG_LEVEL_WERKZEUG=INFO
LOG_LEVEL_SQLALCHEMY=WARNING
LOG_LEVEL_BLEAK=WARNING
LOG_LEVEL_TUYA=WARNING

# Persistencia periódica de telemetría BLE del ESP32
SENSOR_LOG_ENABLED=true
SENSOR_LOG_INTERVAL_SECONDS=60

# Tuya (Tuya IoT / Smart Life)
TUYA_API_KEY=
TUYA_API_SECRET=
TUYA_API_ENDPOINT=https://openapi.tuyaus.com
TUYA_USERNAME=
TUYA_PASSWORD=
TUYA_COUNTRY_CODE=
TUYA_SCHEMA=tuya

# Optional legacy/default device. New devices can be added from the dashboard.
TUYA_DEVICE_ID=

# Optional: tinytuya local device testing
TUYA_DEVICE_IP=
TUYA_DEVICE_KEY=
TUYA_DEVICE_VERSION=3.3
